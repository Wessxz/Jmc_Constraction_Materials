# JMC Hardware - Environment Configuration Template
# Copy this file to .env and update with your local settings

# ============================================
# DATABASE CONFIGURATION
# ============================================
# For XAMPP Local Development:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=jmc_inventory

# For other setups, change accordingly
# Example for remote MySQL:
# DB_HOST=localhost
# DB_USER=your_username
# DB_PASSWORD=your_password
# DB_NAME=your_database

# ============================================
# EMAIL CONFIGURATION (Optional)
# ============================================
# For email notifications (Gmail SMTP)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# To get Gmail app password:
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification
# 3. Go to App passwords
# 4. Generate password for "Mail"

# ============================================
# APPLICATION SETTINGS
# ============================================
# Your local development URL
BASE_URL=http://localhost/jmc_new

# Change this to a random string for security
SECRET_KEY=change-this-to-random-string-for-production

# ============================================
# SETUP INSTRUCTIONS
# ============================================
# 1. Copy this file and rename to: .env
# 2. Update DB_USER, DB_PASSWORD, DB_NAME with your MySQL credentials
# 3. Update BASE_URL with your local project path
# 4. Import the database: jmc_inventory_fixed.sql
# 5. Run: add-missing-columns.sql (if needed)
# 6. Access: http://localhost/jmc_new/login.html
# 7. Default admin login:
#    Email: admin@jmcmaterials.com
#    Password: admin123

# ============================================
# PRODUCTION DEPLOYMENT (Hostinger)
# ============================================
# When deploying to Hostinger, use these instead:
# DB_HOST=localhost
# DB_USER=u266998007_JMC_HARDWARE
# DB_PASSWORD=Jmcmaterials@11
# DB_NAME=u266998007_jmc_inventory
# BASE_URL=https://jmchardware.shop
